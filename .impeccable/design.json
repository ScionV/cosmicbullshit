  "components": [
    {
      "name": "Cabinet Action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Primary cabinet action; an 8.5-aspect visible face inside a transparent 44px hit area. Resting preview shows the local gold invitation; production gates it by visibility and motion preference. Busy feedback uses Reading/Issuing plus a decorative fixed-width celestial-symbol sky, with full accessible labels and immediate repeat prevention.",
      "html": "<button class=\"ds-action\" data-state=\"resting\" data-button-motion=\"on\" aria-busy=\"false\"><span class=\"ds-button-face\"><span>Blame the cosmos</span><span class=\"ds-button-sky\" aria-hidden=\"true\" hidden></span></span></button><button class=\"ds-action\" disabled aria-busy=\"true\" aria-label=\"Reading the stars. Your request has been received.\"><span class=\"ds-button-face\"><span>Reading</span><span class=\"ds-button-sky\" aria-hidden=\"true\">🟍✹☾✹🟍</span></span></button>",
      "css": "@font-face{font-family:CosmicSkySymbols;src:url(/fonts/CosmicSkySymbols.woff2) format('woff2');font-weight:400;font-display:swap}.ds-action{position:relative;isolation:isolate;font-family:Buenard,Georgia,serif;font-size:clamp(11px,1.05vw,14px);font-weight:700;line-height:1.1;letter-spacing:.06em;text-transform:uppercase;height:44px;padding:0;width:210px;border:0;background:none;color:#fff2d4;cursor:pointer}.ds-action .ds-button-face{display:flex;align-items:center;justify-content:center;gap:6px;padding:0 4px;width:100%;aspect-ratio:8.5;border:1px solid #cda855;border-radius:999px;background:var(--action,#9c321e);box-shadow:0 2px 5px #32181266;transition:background .16s,translate .16s;white-space:nowrap}.ds-action:hover .ds-button-face{background:#7e2417;translate:0 -1px}.ds-action:active .ds-button-face{translate:0 1px}.ds-action:disabled{cursor:wait}.ds-action:disabled .ds-button-face{background:#773425}.ds-action:focus-visible{outline:3px solid var(--focus,#722d47);outline-offset:5px;border-radius:3px}.ds-action::before{content:'';position:absolute;z-index:-1;left:0;top:50%;width:100%;aspect-ratio:8.5;border-radius:999px;background:var(--gold,#dfb567);box-shadow:0 2px 12px 4px #dfb567c9;opacity:0;transform:translateY(-50%);pointer-events:none}.ds-action[data-state='resting'][data-button-motion='on']:not(:disabled)::before{animation:ds-beckon-cosmos 3.2s ease-in-out infinite}.ds-action .ds-button-sky{flex:none;width:5em;font-family:CosmicSkySymbols,'Segoe UI Symbol',sans-serif;font-size:.9em;font-weight:400;line-height:1;letter-spacing:0;white-space:pre;text-align:left}.ds-action [hidden]{display:none!important}@keyframes ds-beckon-cosmos{0%,100%{opacity:.15;transform:translateY(-50%) scale(.98)}50%{opacity:.85;transform:translateY(-50%) scale(1.04)}}@media(max-width:700px){.ds-action{font-size:11px;letter-spacing:.03em}}@media(prefers-reduced-motion:reduce){.ds-action::before{animation:none!important}.ds-action .ds-button-face{transition:none}}"
    },
