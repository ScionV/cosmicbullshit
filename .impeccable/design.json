  "narrative": {
    "northStar": "The Weary Cosmic Clerk",
    "overview": "Cosmic Bullshit feels like an old printed amusement made operational: warm ochre paper, plum engraving, worn brass, and an exhausted but charming clerk. The illustration carries the ornate personality; the surrounding interface stays readable and spare. The humor is warm, absurd, and plainly entertainment.\n\nThis document records the implemented system in `src/pages/index.astro`, `src/styles/home.css`, and `src/scripts/fortune-machine.ts`. It describes code authority, not a finish verdict. The user approved the taller production cabinet during asset review; the original decision comp retains shorter geometry. Automated comparison and plate concerns remain open and are not converted into design rules.",
    "keyCharacteristics": [
      "Warm printed material and plum ink.",
      "One locally hosted serif family with a compact hierarchy.",
      "Illustrated depth with real HTML text and controls.",
      "Mostly still character performance with deliberate comic pauses.",
      "Clear separation between factual sky events and invented excuses."
    ],
    "rules": [
      {
        "name": "The Ink and Paper Rule",
        "body": "Use plum text on the warm paper ground for ordinary content; reserve vermilion for the primary action.",
        "section": "colors"
      },
      {
        "name": "The Material Depth Rule",
        "body": "Add depth where an object physically meets another surface; keep ordinary text content on the paper ground.",
        "section": "elevation"
      },
      {
        "name": "The Still First Rule",
        "body": "Keep the clerk still most of the time; animate one restrained gesture only after a random 15–30 second pause or a user request.",
        "section": "components"
      }
    ],
    "dos": [
      "Do preserve warm paper, plum ink, and restrained vermilion action.",
      "Do keep text and interaction in live HTML above the illustration.",
      "Do preserve the clerk's identity, steady lighting, fixed window, and long still pauses.",
      "Do retain visible factual-versus-invented labels, keyboard focus, motion preferences, and asset provenance."
    ],
    "donts": [
      "Don't replace the illustration's material depth with generic floating cards.",
      "Don't bake changing fortune text or the interactive action label into artwork.",
      "Don't turn unresolved plate edges, crop drift, or old-comp geometry differences into reusable design rules.",
      "Don't describe this documentation or the taller-cabinet approval as a closed finish review."
    ]
  }
}
